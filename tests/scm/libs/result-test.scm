;;; result 模块测试
(require 'result)

(check '(ok 1) (ok 1))
(check '(err "bad") (err "bad"))
(check #t (ok? (ok 1)))
(check #f (ok? (err "bad")))
(check #t (err? (err "bad")))
(check #f (err? (ok 1)))
(check '(ok 2) (result-map (lambda (x) (+ x 1)) (ok 1)))
(check '(err "bad") (result-map (lambda (x) (+ x 1)) (err "bad")))
(check '(err "worse") (result-map-err (lambda (e) "worse") (err "bad")))
(check '(ok 1) (result-map-err (lambda (e) "worse") (ok 1)))
(check '(ok 2) (result-bind (ok 1) (lambda (x) (ok (+ x 1)))))
(check '(err "bad") (result-bind (err "bad") (lambda (x) (ok (+ x 1)))))
(check '(err "boom") (result-bind (ok 1) (lambda (x) (err "boom"))))
(check 42 (result-get (ok 42)))
(check "bad" (result-get-err (err "bad")))
(check 42 (result-get-or (ok 42) 0))
(check 0 (result-get-or (err "bad") 0))
